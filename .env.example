# Local development only; copy to .env. Never reuse this password in production.
NODE_ENV=development
DATABASE_URL=postgres://madar:madar_local_only@127.0.0.1:55432/madar
HOST=127.0.0.1
API_PORT=4100
WEB_PORT=3100
API_INTERNAL_URL=http://127.0.0.1:4100
# Generate: openssl rand -hex 32; never expose this to the browser.
ADMIN_API_KEY=replace-with-at-least-32-random-characters
ENABLE_NETWORK_INGESTION=false
LOG_LEVEL=info
WORKER_POLL_SECONDS=30
